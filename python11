            filetypes=[("Excel / CSV / text files", "*.xlsx *.xlsm *.xlsb *.xls *.csv *.txt"),
                       ("All files", "*.*")],
        )
        if path:
            self.var_order.set(str(Path(path)))

    # ---- settings ---------------------------------------------------------------
    def _load_settings(self) -> None:
        try:
            data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return
        for key, var in self._persisted.items():
            if key in data:
                try:
                    var.set(data[key])
                except tk.TclError:
                    pass
        if os.name != "nt":
            self.var_human.set(False)

    def _save_settings(self) -> None:
        try:
            data = {k: v.get() for k, v in self._persisted.items()}
            SETTINGS_FILE.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
        except (OSError, tk.TclError):
            pass

    # ---- processing control ---------------------------------------------------------
    def _set_running(self, running: bool) -> None:
        self.btn_run.config(state=tk.DISABLED if running else tk.NORMAL)
        self.btn_cancel.config(state=tk.NORMAL if running else tk.DISABLED)

    def _set_status(self, text: str, color: str) -> None:
        self.lbl_status.config(text=text, fg=color)

    @staticmethod
    def _to_int(value: str) -> int:
        return int(value) if value.strip().isdigit() else 0

    def _start(self) -> None:
        input_dir = self.var_input.get().strip()
        output_dir = self.var_output.get().strip()
        if not input_dir or not output_dir:
            self._set_status("Error: input and output folders are required.", self.ERR)
            return
        if not Path(input_dir).is_dir() or not Path(output_dir).is_dir():
            self._set_status("Error: the selected input or output folder does not exist.", self.ERR)
            return

        order = self.var_order.get().strip()
        opts = MergeOptions(
            input_dir=Path(input_dir),
            output_dir=Path(output_dir),
            order_file=Path(order) if order else None,
            skip_top=self._to_int(self.var_top.get()),
            skip_bottom=self._to_int(self.var_bottom.get()),
            add_source_column=self.var_source.get(),
            merge_like_human=self.var_human.get(),
        )
        self._save_settings()
        self._cancel_event.clear()
        self._last_result = None
        for b in (self.btn_open_file, self.btn_open_report, self.btn_open_folder):
            b.config(state=tk.DISABLED)
        self._clear_log()
        self._log_line("Started - mode: "
                       + ("Merge like human (Excel)" if opts.merge_like_human else "Standard"))
        self._set_running(True)
        self.progress.config(value=0)
        self._set_status("Processing… please wait.", self.ACCENT)
        self._worker = threading.Thread(target=self._worker_main, args=(opts,), daemon=True)
        self._worker.start()

    def _cancel(self) -> None:
        self._cancel_event.set()
        self._set_status("Cancelling… (finishing the current file)", self.MUTED)

    def _worker_main(self, opts: MergeOptions) -> None:
        """Runs in a worker thread - talks to the GUI ONLY through the queue."""
        try:
            result = merge_folder(
                opts,
                progress=lambda d, t, m: self._events.put(("progress", d, t, m)),
                cancel=self._cancel_event,
            )
            self._events.put(("done", result))
        except PermissionError:
            self._events.put(("error", "Write access denied. Close the file in Excel or choose another folder."))
        except (ValueError, RuntimeError) as exc:  # user-facing messages
            log.error("Merge stopped: %s", exc)
            self._events.put(("error", str(exc)))
        except Exception as exc:  # noqa: BLE001
            log.error("Merge failed:\n%s", traceback.format_exc())
            where = error_location(exc)
            self._events.put(("error", describe_exception(exc) + (f"  [{where}]" if where else "")))

    def _poll_events(self) -> None:
        try:
            while True:
                event = self._events.get_nowait()
                kind = event[0]
                if kind == "progress":
                    _, done, total, msg = event
                    self.progress.config(value=100 * done / max(total, 1))
                    self._set_status(msg, self.ACCENT)
                    self._log_line(msg)
                elif kind == "done":
                    self._on_done(event[1])
                elif kind == "error":
                    self._set_running(False)
                    self.progress.config(value=0)
                    self._set_status(f"Error: {event[1]}", self.ERR)
                    self._log_line(f"ERROR: {event[1]}")
        except queue.Empty:
            pass

        if self._closing and not (self._worker and self._worker.is_alive()):
            self._save_settings()
            self.destroy()
            return
        self.after(100, self._poll_events)

    def _on_done(self, res: MergeResult) -> None:
        self._set_running(False)
        if res.cancelled:
            self.progress.config(value=0)
            self._set_status("Cancelled - no file was saved.", self.MUTED)
            self._log_line("Cancelled - no file was saved.")
            return

        self._last_result = res
        self.progress.config(value=100)
        out_name = res.output_file.name if res.output_file else ""
        rep_name = res.report_file.name if res.report_file else "(report not saved)"
        has_issues = bool(res.errors or res.warnings)
        msg = (f"Done: {res.files_ok}/{res.files_total} files, {res.sheets} sheets\n"
               f"Rows: {res.rows_read:,} read, {res.rows_removed:,} removed, {res.rows:,} in output\n"
               f"{out_name}  |  {rep_name}")
        color = self.ERR if res.errors else (self.WARN if has_issues else self.OK)
        self._set_status(msg, color)

        self._log_line(f"Done: {res.files_ok}/{res.files_total} files, {res.sheets} sheets, "
                       f"{res.rows:,} rows in output.")
        for e in res.errors:
            self._log_line(f"ERROR: {e}")
        for w in res.warnings:
            self._log_line(f"WARNING: {w}")

        if res.output_file:
            self.btn_open_file.config(state=tk.NORMAL)
            self.btn_open_folder.config(state=tk.NORMAL)
        if res.report_file:
            self.btn_open_report.config(state=tk.NORMAL)

        if res.errors:
            messagebox.showwarning("Merge report", self._format_issues(res))
        if self.var_open.get() and res.output_file:
            open_path(res.output_file.parent)

    def _open_result(self, what: str) -> None:
        res = self._last_result
        if not res:
            return
        if what == "output_file" and res.output_file:
            open_path(res.output_file)
        elif what == "report_file" and res.report_file:
            open_path(res.report_file)
        elif what == "folder" and res.output_file:
            open_path(res.output_file.parent)

    @staticmethod
    def _format_issues(res: MergeResult, limit: int = 15) -> str:
        lines: List[str] = []
        if res.errors:
            lines.append(f"Files with errors ({len(res.errors)}):")
            lines += [f"  • {e}" for e in res.errors[:limit]]
            if len(res.errors) > limit:
                lines.append("  …")
        if res.warnings:
            lines.append(f"\nWarnings ({len(res.warnings)}):")
            lines += [f"  • {w}" for w in res.warnings[:limit]]
            if len(res.warnings) > limit:
                lines.append("  …")
        if res.report_file:
            lines.append(f"\nTXT report: {res.report_file}")
        lines.append(f"Full log: {LOG_FILE}")
        return "\n".join(lines)

    def _on_close(self) -> None:
        if self._worker and self._worker.is_alive():
            if not messagebox.askyesno(
                "Merge in progress",
                "A merge is still running.\n\nCancel it and exit?\n"
                "(The program waits for the current file so that Excel is closed cleanly.)",
            ):
                return
            self._cancel_event.set()
            self._closing = True
            self._set_status("Waiting for the current operation to finish…", self.MUTED)
            return
        self._save_settings()
        self.destroy()


def main() -> None:
    try:
        enable_dpi_awareness()
        app = MergerApp()
        log.info("Main loop started.")
        app.mainloop()
    except Exception as exc:  # noqa: BLE001
        log.critical("FATAL CRASH:\n%s", traceback.format_exc())
        show_native_error("Critical application error",
                          f"An error occurred:\n\n{exc}\n\nSee: {LOG_FILE}")
        sys.exit(1)


if __name__ == "__main__":
    main()
