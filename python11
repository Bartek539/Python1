# 5. ENGINE B - "MERGE LIKE HUMAN" (Microsoft Excel through COM)
# =============================================================================
def _ensure_process_gone(pid: int, timeout_ms: int = 5000) -> None:
    """Last-resort cleanup: terminate our private Excel process if it did not exit."""
    if not pid or os.name != "nt":
        return
    try:
        kernel32 = ctypes.windll.kernel32
        SYNCHRONIZE, PROCESS_TERMINATE = 0x00100000, 0x0001
        handle = kernel32.OpenProcess(SYNCHRONIZE | PROCESS_TERMINATE, False, pid)
        if not handle:
            return  # already gone
        try:
            if kernel32.WaitForSingleObject(handle, timeout_ms) != 0:  # not WAIT_OBJECT_0
                log.warning("Excel process %s did not exit - terminating it.", pid)
                kernel32.TerminateProcess(handle, 1)
        finally:
            kernel32.CloseHandle(handle)
    except Exception:  # noqa: BLE001
        log.warning("Process cleanup failed:\n%s", traceback.format_exc())


class ExcelSession:
    """A private, invisible Excel instance driven through COM.

    * DispatchEx always starts a NEW Excel process, so a workbook the user has
      open in their own Excel is never touched (and never closed by Quit()).
    * Macros are disabled, alerts and events are off, files are opened read-only.
    * close() quits Excel and, if the process survives, terminates it.
    """

    def __init__(self) -> None:
        self.excel: Any = None
        self.wb: Any = None
        self._pid = 0
        self._com_ready = False
        self._pythoncom: Any = None
        self._initial_sheets: List[Any] = []
        self._used_names: Set[str] = set()

    # -- lifecycle -------------------------------------------------------------
    def __enter__(self) -> "ExcelSession":
        try:
            self._start()
        except BaseException:
            self.close()
            raise
        return self

    def __exit__(self, *_exc) -> bool:
        self.close()
        return False

    def _start(self) -> None:
        try:
            import pythoncom
            import win32com.client as win32
        except ImportError as exc:
            raise RuntimeError(
                "The 'pywin32' package is required for 'Merge like human' "
                "(install it with: pip install pywin32)."
            ) from exc

        self._pythoncom = pythoncom
        pythoncom.CoInitialize()  # COM must be initialised in the thread that uses it
        self._com_ready = True
        try:
            self.excel = win32.DispatchEx("Excel.Application")
        except Exception as exc:  # noqa: BLE001
            raise RuntimeError(
                "Microsoft Excel could not be started. 'Merge like human' requires "
                "an installed desktop version of Excel."
            ) from exc

        try:
            pid = ctypes.c_ulong(0)
            ctypes.windll.user32.GetWindowThreadProcessId(int(self.excel.Hwnd), ctypes.byref(pid))
            self._pid = int(pid.value)
        except Exception:  # noqa: BLE001
            self._pid = 0

        for attr, value in (
            ("Visible", False),
            ("DisplayAlerts", False),
            ("ScreenUpdating", False),
            ("EnableEvents", False),
            ("AutomationSecurity", MSO_AUTOMATION_SECURITY_FORCE_DISABLE),
        ):
            try:
                setattr(self.excel, attr, value)
            except Exception:  # noqa: BLE001
                log.info("Excel setting %s could not be applied.", attr)

        self.wb = self.excel.Workbooks.Add()
        try:
            self.excel.Calculation = XL_CALC_MANUAL  # much faster while pasting
        except Exception:  # noqa: BLE001
            pass
        # remember the default sheets of the new workbook - removed before saving
        self._initial_sheets = [
            self.wb.Worksheets(i) for i in range(1, self.wb.Worksheets.Count + 1)
        ]

    def close(self) -> None:
        wb, excel, pid = self.wb, self.excel, self._pid
        self.wb = None
        self.excel = None
        self._initial_sheets = []
        if wb is not None:
            try:
                wb.Close(SaveChanges=False)
            except Exception:  # noqa: BLE001
                pass
        if excel is not None:
            try:
                excel.CutCopyMode = False
            except Exception:  # noqa: BLE001
                pass
            try:
                excel.Quit()
            except Exception:  # noqa: BLE001
                pass
        wb = excel = None  # release COM references before the process check
        gc.collect()
        _ensure_process_gone(pid)
        self._pid = 0
        if self._com_ready and self._pythoncom is not None:
            try:
                self._pythoncom.CoUninitialize()
            except Exception:  # noqa: BLE001
                pass
            self._com_ready = False

    # -- reading ---------------------------------------------------------------
    def open_book(self, path: Path) -> Any:
        """Opens a source file read-only. An empty password turns a password prompt
        (which would hang an invisible Excel) into a normal error."""
        return self.excel.Workbooks.Open(
            str(path.resolve()),
            UpdateLinks=0,
            ReadOnly=True,
            IgnoreReadOnlyRecommended=True,
            Password="",
            WriteResPassword="",
        )

    def extent(self, ws: Any) -> Optional[Tuple[int, int]]:
        """(last_row, last_col) measured from A1, or None for a sheet without values."""
        used = ws.UsedRange
        try:
            if self.excel.WorksheetFunction.CountA(used) == 0:
                return None
        except Exception:  # noqa: BLE001
            pass
        return (
            int(used.Row + used.Rows.Count - 1),
            int(used.Column + used.Columns.Count - 1),
        )

    @staticmethod
    def show_all_rows(ws: Any) -> None:
        """A filtered sheet would copy visible rows only - reveal everything (in memory)."""
        try:
            if ws.FilterMode:
                ws.ShowAllData()
        except Exception:  # noqa: BLE001
            pass

    @staticmethod
    def header_names(ws: Any, last_row: int, last_col: int) -> List[str]:
        """Column names of the first non-empty row (used to match CSV files to sheets)."""
        rows_n, cols_n = min(last_row, 30), min(last_col, 256)
        value = ws.Range(ws.Cells(1, 1), ws.Cells(rows_n, cols_n)).Value
        rows = [value] if not isinstance(value, tuple) else value
        for row in rows:
            cells = row if isinstance(row, tuple) else (row,)
            if any(v is not None and str(v).strip() for v in cells):
                return [header_text(v, i) for i, v in enumerate(cells) if v is not None]
        return []

    # -- writing ---------------------------------------------------------------
    def add_sheet(self, display: str) -> Tuple[Any, str]:
        count = self.wb.Worksheets.Count
        ws = self.wb.Worksheets.Add(After=self.wb.Worksheets(count))
        name = unique_sheet_name(display, self._used_names)
        try:
            ws.Name = name
        except Exception:  # noqa: BLE001 (e.g. reserved name)
            name = unique_sheet_name(f"Sheet{count + 1}", self._used_names)
            ws.Name = name
        return ws, name

    def copy_block(
        self, src_ws: Any, last_row: int, last_col: int, dest_ws: Any, dest_row: int,
        with_widths: bool,
    ) -> None:
        """Ctrl+A / Ctrl+C / Ctrl+V of a sheet: everything from A1 to the last used cell.

        Range.Copy(Destination) pastes values, formulas and all formatting and does
        not depend on (or overwrite) the Windows clipboard.
        """
        src_rng = src_ws.Range(src_ws.Cells(1, 1), src_ws.Cells(last_row, last_col))
        src_rng.Copy(dest_ws.Cells(dest_row, 1))
        try:
            self.excel.CutCopyMode = False
        except Exception:  # noqa: BLE001
            pass
        if with_widths:
            for c in range(1, min(last_col, MAX_WIDTH_COLUMNS) + 1):
                try:
                    dest_ws.Columns(c).ColumnWidth = src_ws.Columns(c).ColumnWidth
                except Exception:  # noqa: BLE001
                    break

    def finalize_and_save(self, path: Path) -> None:
        for ws in self._initial_sheets:
            try:
                ws.Delete()
            except Exception:  # noqa: BLE001
                log.info("Default sheet could not be deleted.")
        self._initial_sheets = []
        try:
            self.excel.Calculation = XL_CALC_AUTOMATIC
        except Exception:  # noqa: BLE001
            pass
        for i in range(self.wb.Worksheets.Count, 0, -1):  # ends with the first sheet active
            try:
                ws = self.wb.Worksheets(i)
                ws.Activate()
                ws.Range("A1").Select()
            except Exception:  # noqa: BLE001
                pass
        self.wb.SaveAs(str(path.resolve()), FileFormat=XL_OPEN_XML_WORKBOOK)
        self.wb.Close(SaveChanges=False)
        self.wb = None


@dataclass
class TargetPart:
    ws: Any
    name: str
    rows: int = 0  # rows already written; the next free row is rows + 1


@dataclass
class TargetSheet:
    display: str
    parts: List[TargetPart] = field(default_factory=list)


_CSV_NUMBER_DIGITS = 15


def csv_cell(value) -> Any:
    """Typed value of a CSV cell for the scratch workbook (numbers stay numbers,
    codes with leading zeros and very long IDs stay text)."""
    if value is None:
        return None
    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass
    text = str(value)
    if _PLAIN_NUMBER.fullmatch(text) and len(text.replace("-", "").replace(".", "")) <= _CSV_NUMBER_DIGITS:
        return float(text) if "." in text else int(text)
    return _ILLEGAL_XML.sub("", text)[:32767]


def csv_header_names(raw: "pd.DataFrame") -> List[str]:
    for row in raw.itertuples(index=False, name=None):
        if any(not pd.isna(v) for v in row):
            return [header_text(v, i) for i, v in enumerate(row) if not pd.isna(v)]
    return []


def write_csv_workbook(raw: "pd.DataFrame", path: Path) -> None:
    """Scratch .xlsx with the CSV grid, so Excel can copy it like any other sheet
    (no locale-dependent parsing of the CSV text by Excel)."""
    values = [[csv_cell(v) for v in row] for row in raw.itertuples(index=False, name=None)]
    pd.DataFrame(values, dtype=object).to_excel(path, header=False, index=False, engine="openpyxl")


def _human_copy_all(
    xl: ExcelSession,
    xl_files: List[Path],
    csv_files: List[Path],
    scratch: Path,
    res: MergeResult,
    report: ProgressCb,
    cancel: Optional[threading.Event],
    total_steps: int,
) -> List[Tuple[str, int]]:
    """Copies every sheet into the output workbook. Returns [(sheet name, rows)].

    All COM objects created here are local to this function, so they are released
    before the Excel session is closed.
    """
    targets: Dict[str, TargetSheet] = {}
    records: List[Record] = []  # header-only tables, used to match CSV files to sheets
    n_files = len(xl_files) + len(csv_files)

    def place(key: str, display: str, src_ws: Any, last_row: int, last_col: int) -> None:
        target = targets.setdefault(key, TargetSheet(display))
        part = target.parts[-1] if target.parts else None
        created = False
        if part is None or part.rows + last_row > EXCEL_MAX_ROWS:
            if part is not None:
                msg = f"Sheet '{display}' exceeds the Excel row limit - continued in a new sheet."
                if msg not in res.warnings:
                    res.warnings.append(msg)
            label = display if not target.parts else f"{display} ({len(target.parts) + 1})"
            ws, name = xl.add_sheet(label)
            part = TargetPart(ws, name)
            target.parts.append(part)
            created = True
        xl.copy_block(src_ws, last_row, last_col, part.ws, part.rows + 1, created)
        part.rows += last_row

    # ---- pass 1: Excel files (in the chosen order) ----
    for k, path in enumerate(xl_files):
        if cancel is not None and cancel.is_set():
            res.cancelled = True
            return []
        report(k, total_steps, f"Copying {k + 1}/{n_files}: {path.name}")
        book = None
        copied = 0
        try:
            book = xl.open_book(path)
            for i in range(1, book.Worksheets.Count + 1):
                ws = book.Worksheets(i)
                name = str(ws.Name).strip()
                extent = xl.extent(ws)
                if extent is None:
                    res.stats.append(SheetStat(file=path.name, sheet=name))
                    continue
                last_row, last_col = extent
                xl.show_all_rows(ws)
                headers = xl.header_names(ws, last_row, last_col)
                st = SheetStat(file=path.name, sheet=name, raw=last_row, kept=last_row)
                key = name.casefold()
                place(key, name, ws, last_row, last_col)
                res.stats.append(st)
                records.append(Record(key, name, pd.DataFrame(columns=headers), path.name, st))
                copied += 1
            res.files_ok += 1
            if copied == 0:
                res.warnings.append(f"{path.name}: no data found")
        except Exception as exc:  # noqa: BLE001
            log.error("Error in file %s:\n%s", path.name, traceback.format_exc())
            note = f" (partially copied: {copied} sheet(s))" if copied else ""
            res.errors.append(f"{path.name}: {describe_exception(exc)}{note}")
        finally:
            if book is not None:
                try:
                    book.Close(SaveChanges=False)
                except Exception:  # noqa: BLE001
                    pass
            ws = book = None

    # ---- pass 2a: CSV files -> scratch workbooks + header info ----
    csv_jobs: List[Tuple[Record, Path]] = []
    for j, path in enumerate(csv_files):
        if cancel is not None and cancel.is_set():
            res.cancelled = True
            return []
        report(len(xl_files) + j, total_steps, f"Reading CSV {len(xl_files) + j + 1}/{n_files}: {path.name}")
        try:
            raw = read_csv_raw(path)
            st = SheetStat(file=path.name, is_csv=True, raw=len(raw), kept=len(raw))
            if raw.empty:
                res.stats.append(SheetStat(file=path.name, is_csv=True))
                res.files_ok += 1
                res.warnings.append(f"{path.name}: file is empty")
                continue
            scratch_file = scratch / f"csv_{len(csv_jobs)}.xlsx"
            write_csv_workbook(raw, scratch_file)
            rec = Record(None, "", pd.DataFrame(columns=csv_header_names(raw)), path.name, st)
            records.append(rec)
            csv_jobs.append((rec, scratch_file))
            res.stats.append(st)
            res.files_ok += 1
        except Exception as exc:  # noqa: BLE001
            log.error("Error in file %s:\n%s", path.name, traceback.format_exc())
            res.errors.append(f"{path.name}: {describe_exception(exc)}")

    if csv_jobs:
        assign_csv_records(records, res)

    # ---- pass 2b: CSV data -> sheets ----
    for rec, scratch_file in csv_jobs:
        if cancel is not None and cancel.is_set():
            res.cancelled = True
            return []
        book = None
        try:
            book = xl.open_book(scratch_file)
            ws = book.Worksheets(1)
            extent = xl.extent(ws)
            if extent is None:  # only blank cells
                rec.stat.empty, rec.stat.kept = rec.stat.raw, 0
                continue
            last_row, last_col = extent
            rec.stat.kept = last_row
            rec.stat.empty = rec.stat.raw - last_row  # trailing blank rows
            place(rec.key or rec.display.casefold(), rec.display, ws, last_row, last_col)
        except Exception as exc:  # noqa: BLE001
            log.error("Error in file %s:\n%s", rec.file, traceback.format_exc())
            res.errors.append(f"{rec.file}: {describe_exception(exc)}")
            if rec.stat in res.stats:  # nothing reached the output - keep the books balanced
                res.stats.remove(rec.stat)
                res.files_ok -= 1
        finally:
            if book is not None:
                try:
                    book.Close(SaveChanges=False)
                except Exception:  # noqa: BLE001
                    pass
            ws = book = None

    out_sheets = [(p.name, p.rows) for t in targets.values() for p in t.parts]
    targets.clear()
    return out_sheets


def _merge_human(
    opts: MergeOptions,
    files: List[Path],
    res: MergeResult,
    report: ProgressCb,
    cancel: Optional[threading.Event],
    tmp_file: Path,
) -> None:
    """Merge like a human; the workbook is saved to `tmp_file`."""
    xl_files = [p for p in files if p.suffix.lower() != ".csv"]
    csv_files = [p for p in files if p.suffix.lower() == ".csv"]
    total_steps = len(files) + 1
    scratch = Path(tempfile.mkdtemp(prefix="xlmerge_"))
    try:
        with ExcelSession() as xl:
            out_sheets = _human_copy_all(
                xl, xl_files, csv_files, scratch, res, report, cancel, total_steps
            )
            if res.cancelled:
                return
            if not out_sheets:
                detail = f" First error: {res.errors[0]}" if res.errors else ""
                raise ValueError("No data could be copied from the input files." + detail)
            report(len(files), total_steps, "Saving output file (Excel)…")
            xl.finalize_and_save(tmp_file)
        res.sheets = len(out_sheets)
        res.rows = sum(rows for _, rows in out_sheets)
        res.out_sheets = out_sheets
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


# =============================================================================
# 6. REPORT
# =============================================================================
def build_report(res: MergeResult, opts: MergeOptions, generated: datetime) -> str:
    """Plain-text report with the row accounting (input -> removed -> output)."""
    bar = "=" * 78
    thin = "-" * 78
    out_name = res.output_file.name if res.output_file else "-"
    n = lambda v: f"{v:,}"  # noqa: E731
    mode = "Merge like human (Excel copy / paste)" if res.human else "Standard (pandas / openpyxl)"

    L: List[str] = [
        bar,
        f"{APP_NAME} v{APP_VERSION} - MERGE REPORT",
        bar,
        f"Generated      : {generated:%Y-%m-%d %H:%M:%S}",
        f"Mode           : {mode}",
        f"Input folder   : {opts.input_dir}",
        f"Output folder  : {opts.output_dir}",
        f"Output file    : {out_name}",
        f"Order file     : {opts.order_file if opts.order_file else '-'}",
        "",
    ]
    if not res.human:
        L += [
            "Settings",
            f"  Skip rows at top      : {opts.skip_top}",
            f"  Skip rows at bottom   : {opts.skip_bottom}",
            f"  Source file column    : {'yes' if opts.add_source_column else 'no'}",
            "",
        ]
    L += [
        f"Files processed OK : {res.files_ok} / {res.files_total}",
        f"Sheets in output   : {res.sheets}",
        "",
        thin,
        "ROW SUMMARY",
        thin,
        f"Rows read from input files (all rows, incl. headers) : {n(res.rows_read):>14}",
        "",
    ]
    if res.human:
        L += [
            f"Rows removed                                         : {n(res.rows_removed):>14}",
            "   (nothing is removed in 'Merge like human' mode, except trailing blank CSV rows)",
            "",
            f"Rows in the output file (headers included)           : {n(res.rows):>14}",
            "",
        ]
    else:
        L += [
            f"Rows removed (total)                                 : {n(res.rows_removed):>14}",
            f"   - skipped at the top                              : {n(res.removed_top):>14}",
            f"   - header rows (one per source sheet)              : {n(res.removed_header):>14}",
            f"   - empty rows                                      : {n(res.removed_empty):>14}",
            f"   - skipped at the bottom (footer)                  : {n(res.removed_footer):>14}",
            "",
            f"Data rows in the output file                         : {n(res.rows):>14}",
            f"Header rows in the output file (1 per sheet)         : {n(res.sheets):>14}",
            f"Rows in the output file incl. headers                : {n(res.rows + res.sheets):>14}",
            "",
        ]
    balanced = res.rows_read == res.rows_removed + res.rows
    L.append(
        "Check: read = removed + output rows  ->  "
        + ("OK" if balanced else "MISMATCH (see log)")
    )

    L += ["", thin, "OUTPUT SHEETS (rows)", thin]
    if res.out_sheets:
        w = max(len(name) for name, _ in res.out_sheets)
        for name, count in res.out_sheets:
            L.append(f"  {name.ljust(w)}  {n(count):>12}")
    else:
        L.append("  (none)")

    if res.csv_assignments:
        L += ["", thin, "CSV FILES -> SHEETS", thin]
        fw = min(max(len(a) for a, _, _ in res.csv_assignments), 45)
        sw = min(max(len(b) for _, b, _ in res.csv_assignments), 31)
        for file, sheet, how in res.csv_assignments:
            f = file if len(file) <= fw else file[: fw - 1] + "…"
            s = sheet if len(sheet) <= sw else sheet[: sw - 1] + "…"
            L.append(f"  {f.ljust(fw)}  ->  {s.ljust(sw)}  (by {how})")

    L += ["", thin, "PER SOURCE SHEET", thin]
    if res.stats:
        rows = [
            (s.file, s.sheet or "-", s.raw, s.top, s.header, s.empty, s.footer, s.kept)
            for s in res.stats
        ]
        fw = min(max(len("File"), *(len(r[0]) for r in rows)), 45)
        sw = min(max(len("Sheet"), *(len(r[1]) for r in rows)), 31)
        line = "-" * (fw + sw + 4 + 9 * 6 + 2 * 5)

        def fmt(a, b, *nums) -> str:
            a = a if len(a) <= fw else a[: fw - 1] + "…"
            b = b if len(b) <= sw else b[: sw - 1] + "…"
            return f"{a.ljust(fw)}  {b.ljust(sw)}  " + "  ".join(f"{x:>9}" for x in nums)

        L.append(fmt("File", "Sheet", "Read", "Top", "Header", "Empty", "Footer", "Kept"))
        L.append(line)
        for r in rows:
            L.append(fmt(r[0], r[1], *(n(x) for x in r[2:])))
        L.append(line)
        L.append(
            fmt("TOTAL", "", n(res.rows_read), n(res.removed_top), n(res.removed_header),
                n(res.removed_empty), n(res.removed_footer), n(sum(s.kept for s in res.stats)))
        )
    else:
        L.append("  (no data was read)")

    if res.errors:
        L += ["", thin, f"ERRORS ({len(res.errors)}) - rows of failed files are NOT counted above", thin]
        L += [f"  * {e}" for e in res.errors]
    if res.warnings:
        L += ["", thin, f"WARNINGS ({len(res.warnings)})", thin]
        L += [f"  * {w}" for w in res.warnings]

    L.append("")
    return "\n".join(L)


# =============================================================================
# 7. DISPATCHER
# =============================================================================
def merge_folder(
    opts: MergeOptions,
    progress: Optional[ProgressCb] = None,
    cancel: Optional[threading.Event] = None,
) -> MergeResult:
    """Main routine: list files, order them, run the selected engine, save, report.

    Raises ValueError / RuntimeError with a user-readable message on user errors.
    """
    report: ProgressCb = progress or (lambda done, total, msg: None)
    res = MergeResult(human=opts.merge_like_human)

    if not opts.input_dir.is_dir():
        raise ValueError("The input folder does not exist.")
    if not opts.output_dir.is_dir():
        raise ValueError("The output folder does not exist.")
    if opts.merge_like_human and os.name != "nt":
        raise ValueError("'Merge like human' works only on Windows with Microsoft Excel installed.")

    # --- input files (skip Excel temp files and our own previous outputs) ---
    files = [
        p
        for p in opts.input_dir.iterdir()
        if p.is_file()
        and p.suffix.lower() in SUPPORTED_EXTS
        and not p.name.startswith(("~$", OUTPUT_PREFIX))
    ]
    if not files:
        raise ValueError("No Excel/CSV files found in the input folder.")

    # --- ordering ---
    codes: List[str] = []
    if opts.order_file:
        try:
            codes = read_order_list(opts.order_file)
            log.info("Order list loaded: %d entries", len(codes))
        except Exception as exc:  # noqa: BLE001
            log.warning("Order file: %s", exc)
            res.warnings.append(f"Could not load the order file: {exc}")

    if codes:
        files, unmatched, unordered = sort_files(files, codes)
        if unmatched:
            res.warnings.append(
                f"Codes from the order file without a matching file ({len(unmatched)}): "
                + ", ".join(unmatched[:10])
                + (" …" if len(unmatched) > 10 else "")
            )
        if unordered:
            res.warnings.append(
                f"Files not in the order list (appended at the end): {len(unordered)}"
            )
    else:
        files.sort(key=lambda p: natural_key(p.name))

    res.files_total = len(files)

    now = datetime.now()
    stamp = now.strftime("%Y%m%d_%H%M%S")
    tag = "human_" if opts.merge_like_human else ""
    output_file = opts.output_dir / f"{OUTPUT_PREFIX}{tag}{stamp}.xlsx"
    report_file = opts.output_dir / f"{REPORT_PREFIX}{tag}{stamp}.txt"
    tmp_file = output_file.with_name(output_file.stem + ".tmp.xlsx")

    engine = _merge_human if opts.merge_like_human else _merge_standard
    try:
        engine(opts, files, res, report, cancel, tmp_file)
        if res.cancelled:
            return res
        os.replace(tmp_file, output_file)  # atomic: no half-written output
    finally:
        try:
            tmp_file.unlink(missing_ok=True)
        except OSError:
            pass

    res.output_file = output_file

    if res.rows_read != res.rows_removed + res.rows:
        log.error(
            "Row accounting mismatch: read=%d removed=%d output=%d",
            res.rows_read, res.rows_removed, res.rows,
        )

    # --- TXT report (never blocks the merge itself) ---
    try:
        report_file.write_text(build_report(res, opts, now), encoding="utf-8-sig")
        res.report_file = report_file
    except OSError as exc:
        log.warning("Could not write report: %s", exc)
        res.warnings.append(f"Could not write the TXT report: {exc}")

    report(len(files) + 1, len(files) + 1, "Done")
    log.info(
        "Merged %d/%d files -> %s (%d sheets, %d rows; read %d, removed %d) [%s]",
        res.files_ok, res.files_total, output_file, res.sheets, res.rows,
        res.rows_read, res.rows_removed, "human" if res.human else "standard",
    )
    return res


