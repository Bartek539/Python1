SUPPORTED_EXTS = {".xlsx", ".xlsm", ".xlsb", ".xls", ".csv"}
OUTPUT_PREFIX = "merged_output_"
REPORT_PREFIX = "merged_report_"
SOURCE_COL = "_Source_File"
DEFAULT_CSV_SHEET = "Data"
HEADER_MATCH_THRESHOLD = 0.8      # min. column overlap (Jaccard) to attach a CSV to an Excel sheet
EXCEL_MAX_ROWS = 1_048_576        # physical Excel row limit
EXCEL_MAX_DATA_ROWS = EXCEL_MAX_ROWS - 1   # standard mode: one header row per sheet
CSV_ENCODINGS = ("utf-8-sig", "cp1250", "latin-1")

# Excel COM constants
XL_CALC_MANUAL = -4135
XL_CALC_AUTOMATIC = -4105
XL_OPEN_XML_WORKBOOK = 51
MSO_AUTOMATION_SECURITY_FORCE_DISABLE = 3
MAX_WIDTH_COLUMNS = 1000

_BAD_SHEET_CHARS = re.compile(r"[\\/*?:\[\]]")
_ILLEGAL_XML = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f]")
_PLAIN_NUMBER = re.compile(r"-?(0|[1-9]\d*)(\.\d+)?")

ProgressCb = Callable[[int, int, str], None]


