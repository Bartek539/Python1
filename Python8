def setup_logging() -> logging.Logger:
    logger = logging.getLogger(APP_NAME)
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        try:
            handler = RotatingFileHandler(
                LOG_FILE, maxBytes=1_000_000, backupCount=3, encoding="utf-8"
            )
            handler.setFormatter(
                logging.Formatter("%(asctime)s [%(levelname)s] %(message)s")
            )
            logger.addHandler(handler)
        except OSError:
            logger.addHandler(logging.NullHandler())
    return logger


log = setup_logging()


def error_location(exc: BaseException) -> str:
    """Where did it fail? Last frame in this script + innermost frame."""
    frames = traceback.extract_tb(exc.__traceback__)
    if not frames:
        return ""
    own = [f for f in frames if os.path.abspath(f.filename) == os.path.abspath(__file__)]
    parts = []
    if own:
        parts.append(f"{own[-1].name}() line {own[-1].lineno}")
    last = frames[-1]
    if not own or last is not own[-1]:
        parts.append(f"{Path(last.filename).name}:{last.lineno} {last.name}()")
    return " -> ".join(parts)


