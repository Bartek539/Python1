# 3. GUI (skrócone na potrzeby przykładu, funkcje rdzeniowe załączone)
# =============================================================================
class MergerApp(tk.Tk):
    BG = "#F5F5F7"
    FG = "#1D1D1F"

    def __init__(self) -> None:
        super().__init__()
        self.title(f"Multi-Sheet Excel Merger Studio v{APP_VERSION}")
        self.geometry("700x640")
        self.minsize(640, 600)
        self.configure(bg=self.BG)

        self._events: "queue.Queue[tuple]" = queue.Queue()
        self._cancel_event = threading.Event()
        self._worker: Optional[threading.Thread] = None

        self._setup_styles()
        self._build_ui()
        self._load_settings()

        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self.after(100, self._poll_events)

    # [...] (Tutaj pozostają bez zmian metody _setup_styles, _build_ui, _browse*, _load_settings, _start, _worker_main, _poll_events)
    # Poniżej znajduje się zaktualizowany kod raportowania w interfejsie graficznym:

    def _on_done(self, res: MergeResult) -> None:
        self._set_running(False)
        if res.cancelled:
            self.progress.config(value=0)
            self._set_status("Cancelled - no file was saved.", "#86868B")
            return

        self.progress.config(value=100)
        out_name = res.output_file.name if res.output_file else ""
        msg = (f"Done: {res.files_ok}/{res.files_total} files, {res.sheets} sheets, "
               f"{res.rows:,} rows -> {out_name}")
        self._set_status(msg, "#FF9500" if res.errors else "#28CD41")

        # Rozszerzone okno raportu w GUI
        messagebox.showinfo("Merge Complete / Data Audit", self._format_report(res))
        
        if self.var_open.get() and res.output_file and hasattr(os, "startfile"):
            try:
                os.startfile(res.output_file.parent)  # type: ignore[attr-defined]
            except OSError:
                pass

    @staticmethod
    def _format_report(res: MergeResult, limit: int = 10) -> str:
        lines: List[str] = []
        lines.append("DATA AUDIT STATS:")
        lines.append(f"  • Raw data rows read: {res.raw_rows:,}".replace(",", " "))
        lines.append(f"  • Rows removed:       {res.removed_rows:,}".replace(",", " "))
        lines.append(f"  • Final output rows:  {res.rows:,}".replace(",", " "))
        lines.append("-" * 30)
        
        if res.errors:
            lines.append(f"\nFiles with errors ({len(res.errors)}):")
            lines += [f"  [X] {e}" for e in res.errors[:limit]]
            if len(res.errors) > limit:
                lines.append("  …")
        if res.warnings:
            lines.append(f"\nWarnings ({len(res.warnings)}):")
            lines += [f"  [!] {w}" for w in res.warnings[:limit]]
            if len(res.warnings) > limit:
                lines.append("  …")
                
        lines.append(f"\nDetailed report saved in the output folder.")
        return "\n".join(lines)
    
    # [...] (reszta GUI bez zmian)
