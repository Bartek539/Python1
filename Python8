SUPPORTED_EXTS = {".xlsx", ".xlsm", ".xlsb", ".xls", ".csv"}
OUTPUT_PREFIX = "merged_output_"
REPORT_PREFIX = "merged_report_"
SOURCE_COL = "_Source_File"
DEFAULT_CSV_SHEET = "Data"  # used only when there is no Excel sheet and no custom name
EXCEL_MAX_DATA_ROWS = 1_048_575  # Excel row limit minus the header row
CSV_ENCODINGS = ("utf-8-sig", "cp1250", "latin-1")

_BAD_SHEET_CHARS = re.compile(r"[\\/*?:\[\]]")
_ILLEGAL_XML = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f]")


@dataclass
class MergeOptions:
    input_dir: Path
    output_dir: Path
    order_file: Optional[Path] = None
    skip_top: int = 0
    skip_bottom: int = 0
    add_source_column: bool = False
    csv_sheet: str = ""  # target sheet for CSV data; "" = first Excel sheet


@dataclass
class SheetStat:
    """Row accounting for ONE source sheet (or one CSV file).

    Invariant:  raw == top + header + empty + footer + kept
    """
    file: str = ""
    sheet: str = ""
    is_csv: bool = False
    raw: int = 0      # every row that was read (including header and skipped rows)
    top: int = 0      # rows skipped at the top
    header: int = 0   # header row consumed
    empty: int = 0    # completely empty rows removed
    footer: int = 0   # rows skipped at the bottom
    kept: int = 0     # data rows that went on to the merge


@dataclass
class MergeResult:
    output_file: Optional[Path] = None
    report_file: Optional[Path] = None
    files_total: int = 0
    files_ok: int = 0
    sheets: int = 0
    rows: int = 0  # data rows in the output file (header rows not included)
    cancelled: bool = False
    errors: List[str] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)
    stats: List[SheetStat] = field(default_factory=list)
    out_sheets: List[Tuple[str, int]] = field(default_factory=list)

    # --- totals for the report / status line ---
    @property
    def rows_read(self) -> int:
        return sum(s.raw for s in self.stats)

    @property
    def removed_top(self) -> int:
        return sum(s.top for s in self.stats)

    @property
    def removed_header(self) -> int:
        return sum(s.header for s in self.stats)

    @property
    def removed_empty(self) -> int:
        return sum(s.empty for s in self.stats)

    @property
    def removed_footer(self) -> int:
        return sum(s.footer for s in self.stats)

    @property
    def rows_removed(self) -> int:
        return self.removed_top + self.removed_header + self.removed_empty + self.removed_footer


ProgressCb = Callable[[int, int, str], None]


def excel_engine(ext: str) -> str:
    if ext in {".xlsx", ".xlsm"}:
        return "openpyxl"
    if ext == ".xlsb":
        return "pyxlsb"
    return "xlrd"


def natural_key(text: str) -> list:
    """Natural sort: file2 < file10."""
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", text.casefold())]


# ---- reading --------------------------------------------------------------------
def _read_text_any_encoding(path: Path) -> str:
    for enc in CSV_ENCODINGS:
        try:
            with open(path, "r", encoding=enc, newline="") as fh:
                return fh.read()
        except UnicodeDecodeError:
            continue
    raise ValueError(f"Could not detect the text encoding of {path.name}")


def _sniff_delimiter(text: str) -> str:
    sample = text[:50_000]
    try:
        return csv.Sniffer().sniff(sample, delimiters=",;\t|").delimiter
    except csv.Error:
        lines = sample.splitlines()
        first = lines[0] if lines else ""
        return max(",;\t|", key=first.count) if first else ","


def read_csv_raw(path: Path) -> "pd.DataFrame":
    """Reads a CSV as a raw grid of text (no header handling at all).

    Delimiter and encoding are auto-detected. Every row is kept (also empty ones),
    so the row accounting is exact and `skip_top` means physical rows - exactly
    like for Excel sheets.
    """
    text = _read_text_any_encoding(path)
    if not text.strip():
        return pd.DataFrame()
    delim = _sniff_delimiter(text)
    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
    ncols = max((len(r) for r in reader), default=0)
    if ncols == 0:
        return pd.DataFrame()
    return pd.read_csv(
        io.StringIO(text, newline=""),
        sep=delim,
        header=None,
        names=list(range(ncols)),
        dtype=str,
        engine="python",
        skip_blank_lines=False,
    )


def read_order_list(path: Path) -> List[str]:
    """First column of the order file -> list of codes (as text)."""
    ext = path.suffix.lower()
    if ext in {".csv", ".txt"}:
        text = _read_text_any_encoding(path)
        codes = [re.split(r"[;\t,]", line)[0] for line in text.splitlines()]
    else:
        df = pd.read_excel(path, usecols=[0], header=None, dtype=str, engine=excel_engine(ext))
        codes = df.iloc[:, 0].dropna().tolist()
    cleaned = [str(c).strip().strip('"').strip() for c in codes]
    return [c for c in cleaned if c]


def sort_files(
    files: List[Path], codes: List[str]
) -> Tuple[List[Path], List[str], List[Path]]:
    """Sorts files by the list of codes.

    Matching is case-insensitive; when several codes match, the longest wins
    (code "12" will not capture the file for code "123").
    Returns: (sorted files, codes without a file, files without a code).
    """
    lowered = [(i, c.casefold()) for i, c in enumerate(codes)]
    used_codes: set = set()
    ordered: List[Tuple[int, list, Path]] = []
    rest: List[Path] = []

    for p in files:
        name = p.name.casefold()
        hits = [(i, c) for i, c in lowered if c in name]
        if hits:
            best_idx, _ = max(hits, key=lambda h: (len(h[1]), -h[0]))
            used_codes.add(best_idx)
            ordered.append((best_idx, natural_key(p.name), p))
        else:
            rest.append(p)

    ordered.sort(key=lambda t: (t[0], t[1]))
    rest.sort(key=lambda p: natural_key(p.name))
    unmatched = [codes[i] for i, _ in lowered if i not in used_codes]
    return [t[2] for t in ordered] + rest, unmatched, rest


def read_workbook(path: Path) -> List[Tuple[Optional[str], "pd.DataFrame"]]:
    """Reads ALL sheets of a file as RAW grids (header=None).

    Returns [(sheet_name, raw_frame)]; for CSV files sheet_name is None.
    """
    ext = path.suffix.lower()
    if ext == ".csv":
        return [(None, read_csv_raw(path))]

    result: List[Tuple[Optional[str], pd.DataFrame]] = []
    with pd.ExcelFile(path, engine=excel_engine(ext)) as xls:
        for name in xls.sheet_names:
            result.append((str(name), xls.parse(name, header=None)))
    return result


# ---- cleaning -------------------------------------------------------------------
def dedupe_columns(cols: List[str]) -> List[str]:
    seen: Dict[str, int] = {}
    out: List[str] = []
    for c in cols:
        if c in seen:
            seen[c] += 1
            out.append(f"{c}.{seen[c]}")
        else:
            seen[c] = 0
            out.append(c)
    return out


def header_text(value, idx: int) -> str:
    """Header cell -> clean column name (extra spaces/newlines removed)."""
    try:
        if pd.isna(value):
            return f"Unnamed: {idx}"
    except (TypeError, ValueError):
        pass
    if isinstance(value, float) and value.is_integer():
        value = int(value)
    return re.sub(r"\s+", " ", str(value)).strip() or f"Unnamed: {idx}"


def numeric_where_possible(df: "pd.DataFrame") -> "pd.DataFrame":
    """CSV is read as text; turn columns that are fully numeric into numbers,
    so that they stack nicely with the numeric columns coming from Excel files."""
    if df.shape[1] == 0:
        return df
    cols = {}
    for i, name in enumerate(df.columns):
        series = df.iloc[:, i]
        try:
            series = pd.to_numeric(series)
        except (ValueError, TypeError):
            pass
        cols[name] = series
    return pd.DataFrame(cols, index=df.index)


def process_raw(
    raw: "pd.DataFrame", skip_top: int, skip_bottom: int, from_csv: bool
) -> Tuple["pd.DataFrame", SheetStat]:
    """Raw grid -> (clean frame with a header, row statistics).

    Steps: skip top rows -> first non-empty row is the header -> drop empty rows
    -> drop footer rows. Every removed row is counted in the statistics.
    """
    st = SheetStat(raw=len(raw), is_csv=from_csv)
    nothing = pd.DataFrame()

    st.top = min(skip_top, len(raw))
    rest = raw.iloc[st.top:]
    if rest.empty:
        return nothing, st

    blank = rest.isna().all(axis=1).to_numpy()
    filled_pos = (~blank).nonzero()[0]
    if len(filled_pos) == 0:  # nothing but empty rows
        st.empty = len(rest)
        return nothing, st

    h = int(filled_pos[0])  # empty rows above the header
    st.empty = h
    st.header = 1
    header_vals = rest.iloc[h].tolist()

    body = rest.iloc[h + 1:]
    body_filled = body.dropna(how="all")
    st.empty += len(body) - len(body_filled)
    body = body_filled

    # drop columns without a header that contain no data at all
    keep = [
        i for i, v in enumerate(header_vals)
        if not (pd.isna(v) and body.iloc[:, i].isna().all())
    ]
    names = dedupe_columns([header_text(header_vals[i], i) for i in keep])
    body = body.iloc[:, keep].copy()
    body.columns = names

    # footer is counted after empty rows have been removed
    cut = min(skip_bottom, len(body)) if skip_bottom > 0 else 0
    if cut:
        body = body.iloc[:-cut]
        st.footer = cut

    body = numeric_where_possible(body) if from_csv else body.infer_objects()
    body = body.reset_index(drop=True)
    st.kept = len(body)
    return body, st


def make_safe_sheet_names(names: List[str]) -> List[str]:
    """Sheet names: no forbidden characters, max 31 chars, unique (case-insensitive)."""
    used: set = set()
    result: List[str] = []
    for raw in names:
        base = _BAD_SHEET_CHARS.sub("_", raw).strip("'").strip()[:31] or "Sheet"
        candidate, i = base, 2
        while candidate.casefold() in used:
            suffix = f"~{i}"
            candidate = base[: 31 - len(suffix)] + suffix
            i += 1
        used.add(candidate.casefold())
        result.append(candidate)
    return result


def sanitize_for_excel(df: "pd.DataFrame") -> "pd.DataFrame":
    """Removes control characters that make openpyxl raise IllegalCharacterError."""
    obj_cols = [c for c in df.columns if df[c].dtype.kind == "O"]
    if not obj_cols:
        return df
    df = df.copy()
    for c in obj_cols:
        df[c] = df[c].map(lambda v: _ILLEGAL_XML.sub("", v) if isinstance(v, str) else v)
    return df


def _cell_len(value) -> int:
    """Display length of a cell; empty cells (NaN/None/NA) count as 0."""
    try:
        if pd.isna(value):
            return 0
    except (TypeError, ValueError):
        pass
    return len(str(value))


def format_sheet(ws, df: "pd.DataFrame") -> None:
    """Bold header, frozen first row, autofilter, column widths."""
    from openpyxl.styles import Font
    from openpyxl.utils import get_column_letter

    if df.shape[1] == 0:
        return
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions
    bold = Font(bold=True)
    for idx, col in enumerate(df.columns, start=1):
        ws.cell(row=1, column=idx).font = bold
        longest = max([len(str(col))] + [_cell_len(v) for v in df[col].head(500)])
        ws.column_dimensions[get_column_letter(idx)].width = min(max(10, longest + 2), 50)


# ---- report ---------------------------------------------------------------------
def build_report(res: MergeResult, opts: MergeOptions, generated: datetime) -> str:
    """Plain-text report with the row accounting (input -> removed -> output)."""
    bar = "=" * 78
    thin = "-" * 78
    out_name = res.output_file.name if res.output_file else "-"
    n = lambda v: f"{v:,}"  # noqa: E731

    L: List[str] = [
        bar,
        f"{APP_NAME} v{APP_VERSION} - MERGE REPORT",
        bar,
        f"Generated      : {generated:%Y-%m-%d %H:%M:%S}",
        f"Input folder   : {opts.input_dir}",
        f"Output folder  : {opts.output_dir}",
        f"Output file    : {out_name}",
        f"Order file     : {opts.order_file if opts.order_file else '-'}",
        "",
        "Settings",
        f"  Skip rows at top      : {opts.skip_top}",
        f"  Skip rows at bottom   : {opts.skip_bottom}",
        f"  Source file column    : {'yes' if opts.add_source_column else 'no'}",
        f"  Target sheet for CSV  : {opts.csv_sheet.strip() or '(first Excel sheet)'}",
        "",
        f"Files processed OK : {res.files_ok} / {res.files_total}",
        f"Sheets in output   : {res.sheets}",
        "",
        thin,
        "ROW SUMMARY",
        thin,
        f"Rows read from input files (all rows, incl. headers) : {n(res.rows_read):>14}",
        "",
        f"Rows removed (total)                                 : {n(res.rows_removed):>14}",
        f"   - skipped at the top                              : {n(res.removed_top):>14}",
        f"   - header rows (one per source sheet)              : {n(res.removed_header):>14}",
        f"   - empty rows                                      : {n(res.removed_empty):>14}",
        f"   - skipped at the bottom (footer)                  : {n(res.removed_footer):>14}",
        "",
        f"Data rows in the output file                         : {n(res.rows):>14}",
        f"Header rows in the output file (1 per sheet)         : {n(res.sheets):>14}",
        f"Rows in the output file incl. headers                : {n(res.rows + res.sheets):>14}",
        "",
    ]
    balanced = res.rows_read == res.rows_removed + res.rows
    L.append(
        "Check: read = removed + output data rows  ->  "
        + ("OK" if balanced else "MISMATCH (see log)")
    )

    # --- output sheets ---
    L += ["", thin, "OUTPUT SHEETS (data rows)", thin]
    if res.out_sheets:
        w = max(len(name) for name, _ in res.out_sheets)
        for name, count in res.out_sheets:
            L.append(f"  {name.ljust(w)}  {n(count):>12}")
    else:
        L.append("  (none)")

    # --- per file / sheet ---
    L += ["", thin, "PER SOURCE SHEET", thin]
    if res.stats:
        rows = [
            (s.file, s.sheet or "-", s.raw, s.top, s.header, s.empty, s.footer, s.kept)
            for s in res.stats
        ]
        fw = min(max(len("File"), *(len(r[0]) for r in rows)), 45)
        sw = min(max(len("Sheet"), *(len(r[1]) for r in rows)), 25)

        def fmt(a, b, *nums) -> str:
            a = a if len(a) <= fw else a[: fw - 1] + "…"
            b = b if len(b) <= sw else b[: sw - 1] + "…"
            return f"{a.ljust(fw)}  {b.ljust(sw)}  " + "  ".join(f"{x:>9}" for x in nums)

        L.append(fmt("File", "Sheet", "Read", "Top", "Header", "Empty", "Footer", "Kept"))
        L.append("-" * (fw + sw + 4 + 9 * 6 + 2 * 5 + 9 + 2))
        for r in rows:
            L.append(fmt(r[0], r[1], *(n(x) for x in r[2:])))
        L.append("-" * (fw + sw + 4 + 9 * 6 + 2 * 5 + 9 + 2))
        L.append(
            fmt("TOTAL", "", n(res.rows_read), n(res.removed_top), n(res.removed_header),
                n(res.removed_empty), n(res.removed_footer), n(res.rows))
        )
    else:
        L.append("  (no data was read)")

    if res.errors:
        L += ["", thin, f"ERRORS ({len(res.errors)}) - rows of these files are NOT counted above", thin]
        L += [f"  * {e}" for e in res.errors]
    if res.warnings:
        L += ["", thin, f"WARNINGS ({len(res.warnings)})", thin]
        L += [f"  * {w}" for w in res.warnings]

    L.append("")
    return "\n".join(L)


# ---- main routine -----------------------------------------------------------------
def merge_folder(
    opts: MergeOptions,
    progress: Optional[ProgressCb] = None,
    cancel: Optional[threading.Event] = None,
) -> MergeResult:
    """Main routine: read, clean, merge and save. Raises ValueError on user errors."""
    report: ProgressCb = progress or (lambda done, total, msg: None)
    res = MergeResult()

    if not opts.input_dir.is_dir():
        raise ValueError("Input folder does not exist.")
    if not opts.output_dir.is_dir():
        raise ValueError("Output folder does not exist.")

    # --- input files (skip Excel temp files and our own previous outputs) ---
    files = [
        p
        for p in opts.input_dir.iterdir()
        if p.is_file()
        and p.suffix.lower() in SUPPORTED_EXTS
        and not p.name.startswith(("~$", OUTPUT_PREFIX))
    ]
    if not files:
        raise ValueError("No Excel/CSV files found in the input folder.")

    # --- ordering ---
    codes: List[str] = []
    if opts.order_file:
        try:
            codes = read_order_list(opts.order_file)
            log.info("Order list loaded: %d entries", len(codes))
        except Exception as exc:  # noqa: BLE001
            log.warning("Order file: %s", exc)
            res.warnings.append(f"Could not load the order file: {exc}")

    if codes:
        files, unmatched, unordered = sort_files(files, codes)
        if unmatched:
            res.warnings.append(
                f"Codes from the order file without a matching file ({len(unmatched)}): "
                + ", ".join(unmatched[:10])
                + (" …" if len(unmatched) > 10 else "")
            )
        if unordered:
            res.warnings.append(
                f"Files not in the order list (appended at the end): {len(unordered)}"
            )
    else:
        files.sort(key=lambda p: natural_key(p.name))

    res.files_total = len(files)
    total_steps = len(files) + 1

    # --- reading: records keep the file order. sheet_key None = CSV data ---
    # record = (sheet_key | None, display_name | "", frame)
    records: List[Tuple[Optional[str], str, "pd.DataFrame"]] = []
    for n, path in enumerate(files):
        if cancel is not None and cancel.is_set():
            res.cancelled = True
            return res
        report(n, total_steps, f"Loading {n + 1}/{len(files)}: {path.name}")
        try:
            local_records: List[Tuple[Optional[str], str, pd.DataFrame]] = []
            local_stats: List[SheetStat] = []
            for sheet_name, raw in read_workbook(path):
                is_csv = sheet_name is None
                df, st = process_raw(raw, opts.skip_top, opts.skip_bottom, from_csv=is_csv)
                st.file = path.name
                st.sheet = "" if is_csv else sheet_name.strip()
                local_stats.append(st)
                if df.empty:
                    continue
                if opts.add_source_column and SOURCE_COL not in df.columns:
                    df.insert(0, SOURCE_COL, path.name)
                if is_csv:
                    local_records.append((None, "", df))
                else:
                    local_records.append((sheet_name.strip().casefold(), sheet_name.strip(), df))

            # commit only when the whole file was read without errors
            res.stats.extend(local_stats)
            records.extend(local_records)
            res.files_ok += 1
            if not local_records:
                res.warnings.append(f"{path.name}: no data left after applying row filters")
        except Exception as exc:  # noqa: BLE001
            log.error("Error in file %s:\n%s", path.name, traceback.format_exc())
            res.errors.append(f"{path.name}: {type(exc).__name__}: {exc}")

    if not records:
        raise ValueError("No tabular data left after applying row filters.")

    # --- where do CSV rows go? Into the SAME sheets as the Excel data ---
    csv_count = sum(1 for key, _, _ in records if key is None)
    target_display = ""
    if csv_count:
        custom = opts.csv_sheet.strip()
        first_excel = next((disp for key, disp, _ in records if key is not None), "")
        target_display = custom or first_excel or DEFAULT_CSV_SHEET
        res.warnings.append(
            f"CSV data ({csv_count} file(s)) was merged into sheet '{target_display}'."
        )
        for st in res.stats:
            if st.is_csv:
                st.sheet = f"{target_display} (CSV)"
    target_key = target_display.casefold()

    # sheet key (casefold) -> (display name, list of frames), in file order
    sheets: Dict[str, Tuple[str, List[pd.DataFrame]]] = {}
    for key, display, df in records:
        k = key if key is not None else target_key
        d = display if key is not None else target_display
        sheets.setdefault(k, (d, []))[1].append(df)

    # --- concatenation (+ splitting when a sheet exceeds the Excel limit) ---
    parts: List[Tuple[str, pd.DataFrame]] = []
    for display, frames in sheets.values():
        merged = pd.concat(frames, ignore_index=True, sort=False)
        if len(merged) > EXCEL_MAX_DATA_ROWS:
            for k, start in enumerate(range(0, len(merged), EXCEL_MAX_DATA_ROWS), start=1):
                parts.append((f"{display} ({k})", merged.iloc[start : start + EXCEL_MAX_DATA_ROWS]))
            res.warnings.append(
                f"Sheet '{display}' exceeds the Excel row limit - split into parts."
            )
        else:
            parts.append((display, merged))

    safe_names = make_safe_sheet_names([name for name, _ in parts])

    # --- saving: temp file first, then atomic replace ---
    now = datetime.now()
    stamp = now.strftime("%Y%m%d_%H%M%S")
    output_file = opts.output_dir / f"{OUTPUT_PREFIX}{stamp}.xlsx"
    report_file = opts.output_dir / f"{REPORT_PREFIX}{stamp}.txt"
    tmp_file = output_file.with_name(output_file.stem + ".tmp.xlsx")
    report(len(files), total_steps, "Saving output file…")
    try:
        with pd.ExcelWriter(tmp_file, engine="openpyxl") as writer:
            for (_, df), name in zip(parts, safe_names):
                df = sanitize_for_excel(df)
                df.to_excel(writer, sheet_name=name, index=False)
                try:
                    format_sheet(writer.sheets[name], df)
                except Exception:  # noqa: BLE001  (cosmetic only - never block saving)
                    log.warning("Formatting skipped for '%s':\n%s", name, traceback.format_exc())
                    res.warnings.append(f"Formatting skipped for sheet '{name}'")
        os.replace(tmp_file, output_file)
    except Exception:
        try:
            tmp_file.unlink(missing_ok=True)
        except OSError:
            pass
        raise

    res.output_file = output_file
    res.sheets = len(parts)
    res.rows = sum(len(df) for _, df in parts)
    res.out_sheets = [(name, len(df)) for (_, df), name in zip(parts, safe_names)]

    if res.rows_read != res.rows_removed + res.rows:
        log.error(
            "Row accounting mismatch: read=%d removed=%d output=%d",
            res.rows_read, res.rows_removed, res.rows,
        )

    # --- TXT report (never blocks the merge itself) ---
    try:
        report_file.write_text(build_report(res, opts, now), encoding="utf-8-sig")
        res.report_file = report_file
    except OSError as exc:
        log.warning("Could not write report: %s", exc)
        res.warnings.append(f"Could not write the TXT report: {exc}")

    report(total_steps, total_steps, "Done")
    log.info(
        "Merged %d/%d files -> %s (%d sheets, %d rows; read %d, removed %d)",
        res.files_ok, res.files_total, output_file, res.sheets, res.rows,
        res.rows_read, res.rows_removed,
    )
    return res


# =============================================================================
# 3. GUI
# =============================================================================
class MergerApp(tk.Tk):
    BG = "#F5F5F7"
    FG = "#1D1D1F"

    def __init__(self) -> None:
        super().__init__()
        self.title(f"Multi-Sheet Excel Merger Studio v{APP_VERSION}")
        self.geometry("700x700")
        self.minsize(640, 660)
        self.configure(bg=self.BG)

        self._events: "queue.Queue[tuple]" = queue.Queue()
        self._cancel_event = threading.Event()
        self._worker: Optional[threading.Thread] = None

        self._setup_styles()
        self._build_ui()
        self._load_settings()

        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self.after(100, self._poll_events)
        log.info("GUI initialized.")

    # ---- styles --------------------------------------------------------------
    def _setup_styles(self) -> None:
        st = ttk.Style(self)
        st.theme_use("clam")
        st.configure("TLabel", background=self.BG, foreground=self.FG, font=("Segoe UI", 9))
        st.configure("TCheckbutton", background=self.BG, foreground=self.FG, font=("Segoe UI", 9))
        st.configure("TEntry", fieldbackground="#FFFFFF", padding=4)
        st.configure("TSpinbox", fieldbackground="#FFFFFF", padding=3)
        st.configure("Browse.TButton", font=("Segoe UI", 9), background="#0071E3",
                     foreground="white", borderwidth=0, focuscolor="none", padding=(10, 4))
        st.map("Browse.TButton",
               background=[("active", "#0077ED"), ("disabled", "#D2D2D7")],
               foreground=[("disabled", "#86868B")])
        st.configure("Run.TButton", font=("Segoe UI", 10, "bold"), background="#28CD41",
                     foreground="white", borderwidth=0, focuscolor="none", padding=(14, 8))
        st.map("Run.TButton",
               background=[("active", "#24B338"), ("disabled", "#D2D2D7")],
               foreground=[("disabled", "#86868B")])
        st.configure("Cancel.TButton", font=("Segoe UI", 10), background="#FF5F56",
                     foreground="white", borderwidth=0, focuscolor="none", padding=(14, 8))
        st.map("Cancel.TButton",
               background=[("active", "#E0443E"), ("disabled", "#D2D2D7")],
               foreground=[("disabled", "#86868B")])
        st.configure("Horizontal.TProgressbar", troughcolor="#E8E8ED", background="#0071E3")

    # ---- UI construction -------------------------------------------------------
    def _build_ui(self) -> None:
        self.var_input = tk.StringVar()
        self.var_order = tk.StringVar()
        self.var_output = tk.StringVar()
        self.var_top = tk.StringVar(value="0")
        self.var_bottom = tk.StringVar(value="0")
        self.var_csv_sheet = tk.StringVar(value="")
        self.var_source = tk.BooleanVar(value=False)
        self.var_open = tk.BooleanVar(value=True)
        self._persisted = {
            "input": self.var_input, "order": self.var_order, "output": self.var_output,
            "top": self.var_top, "bottom": self.var_bottom, "csv_sheet": self.var_csv_sheet,
            "source": self.var_source, "open": self.var_open,
        }

        content = tk.Frame(self, bg=self.BG)
        content.pack(fill="both", expand=True, padx=25, pady=(12, 4))
        content.columnconfigure(0, weight=1)

        self._path_row(content, 0, "1. Input folder (files to merge):",
                       self.var_input, lambda: self._browse_dir(self.var_input, "Select input folder"))
        self._path_row(content, 1, "2. Order file (optional, column A):",
                       self.var_order, self._browse_order)
        self._path_row(content, 2, "3. Output folder for the merged file:",
                       self.var_output, lambda: self._browse_dir(self.var_output, "Select output folder"))

        opts = tk.LabelFrame(content, text=" Row cleanup options (applied to every sheet / CSV) ",
                             bg=self.BG, fg=self.FG, font=("Segoe UI", 9, "bold"), padx=10, pady=8)
        opts.grid(row=6, column=0, columnspan=2, sticky="ew", pady=(12, 4))
        opts.columnconfigure(0, weight=1)
        opts.columnconfigure(1, weight=1)
        vcmd = (self.register(lambda v: v == "" or v.isdigit()), "%P")

        ttk.Label(opts, text="Skip rows at the top (before the header):").grid(row=0, column=0, sticky="w")
        ttk.Spinbox(opts, from_=0, to=9999, width=10, textvariable=self.var_top,
                    validate="key", validatecommand=vcmd).grid(row=1, column=0, sticky="ew", padx=(0, 10), pady=(2, 0))
        ttk.Label(opts, text="Skip rows at the bottom (footer / totals):").grid(row=0, column=1, sticky="w")
        ttk.Spinbox(opts, from_=0, to=9999, width=10, textvariable=self.var_bottom,
                    validate="key", validatecommand=vcmd).grid(row=1, column=1, sticky="ew", pady=(2, 0))
        ttk.Label(opts, text="Empty rows are ignored when counting footer rows.",
                  foreground="#86868B").grid(row=2, column=0, columnspan=2, sticky="w", pady=(6, 0))

        ttk.Label(opts, text="Target sheet name for CSV data (empty = first Excel sheet):").grid(
            row=3, column=0, columnspan=2, sticky="w", pady=(8, 0))
        ttk.Entry(opts, textvariable=self.var_csv_sheet).grid(
            row=4, column=0, columnspan=2, sticky="ew", pady=(2, 0))

        flags = tk.Frame(content, bg=self.BG)
        flags.grid(row=7, column=0, columnspan=2, sticky="w", pady=(8, 0))
        ttk.Checkbutton(flags, text="Add a column with the source file name (_Source_File)",
                        variable=self.var_source).pack(anchor="w")
        ttk.Checkbutton(flags, text="Open the output folder when finished",
                        variable=self.var_open).pack(anchor="w")

        buttons = tk.Frame(self, bg=self.BG)
        buttons.pack(pady=(8, 6))
        self.btn_run = ttk.Button(buttons, text="RUN MERGE (SHEET BY SHEET)",
                                  style="Run.TButton", command=self._start)
        self.btn_run.pack(side="left", padx=4)
        self.btn_cancel = ttk.Button(buttons, text="Cancel", style="Cancel.TButton",
                                     command=self._cancel, state=tk.DISABLED)
        self.btn_cancel.pack(side="left", padx=4)

        self.progress = ttk.Progressbar(self, mode="determinate", maximum=100)
        self.progress.pack(fill="x", padx=25, pady=(4, 4))
        self.lbl_status = tk.Label(self, text="Ready to merge", bg=self.BG, fg="#86868B",
                                   font=("Segoe UI", 9, "bold"), wraplength=620, justify="center")
        self.lbl_status.pack(pady=(0, 10))

    def _path_row(self, parent: tk.Frame, idx: int, label: str, var: tk.StringVar, command) -> None:
        ttk.Label(parent, text=label).grid(row=idx * 2, column=0, columnspan=2, sticky="w", pady=(8, 2))
        ttk.Entry(parent, textvariable=var).grid(row=idx * 2 + 1, column=0, sticky="ew", padx=(0, 8))
        ttk.Button(parent, text="Browse…", style="Browse.TButton", command=command).grid(row=idx * 2 + 1, column=1)

    # ---- browsing ---------------------------------------------------------------
    def _browse_dir(self, var: tk.StringVar, title: str) -> None:
        path = filedialog.askdirectory(title=title, initialdir=var.get() or None)
        if path:
            var.set(str(Path(path)))

    def _browse_order(self) -> None:
        path = filedialog.askopenfilename(
            title="Select order file",
            filetypes=[("Excel / CSV files", "*.xlsx *.xlsm *.xlsb *.xls *.csv"), ("All files", "*.*")],
        )
        if path:
            self.var_order.set(str(Path(path)))

    # ---- settings ---------------------------------------------------------------
    def _load_settings(self) -> None:
        try:
            data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return
        for key, var in self._persisted.items():
            if key in data:
                try:
                    var.set(data[key])
                except tk.TclError:
                    pass

    def _save_settings(self) -> None:
        try:
            data = {k: v.get() for k, v in self._persisted.items()}
            SETTINGS_FILE.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
        except (OSError, tk.TclError):
            pass

    # ---- processing control ---------------------------------------------------------
    def _set_running(self, running: bool) -> None:
        self.btn_run.config(state=tk.DISABLED if running else tk.NORMAL)
        self.btn_cancel.config(state=tk.NORMAL if running else tk.DISABLED)

    def _set_status(self, text: str, color: str) -> None:
        self.lbl_status.config(text=text, fg=color)

    @staticmethod
    def _to_int(value: str) -> int:
        return int(value) if value.strip().isdigit() else 0

    def _start(self) -> None:
        input_dir = self.var_input.get().strip()
        output_dir = self.var_output.get().strip()
        if not input_dir or not output_dir:
            self._set_status("Error: input and output folders are required.", "#D70015")
            return

        order = self.var_order.get().strip()
        opts = MergeOptions(
            input_dir=Path(input_dir),
            output_dir=Path(output_dir),
            order_file=Path(order) if order else None,
            skip_top=self._to_int(self.var_top.get()),
            skip_bottom=self._to_int(self.var_bottom.get()),
            add_source_column=self.var_source.get(),
            csv_sheet=self.var_csv_sheet.get().strip(),
        )
        self._save_settings()
        self._cancel_event.clear()
        self._set_running(True)
        self.progress.config(value=0)
        self._set_status("Processing… please wait.", "#0071E3")
        self._worker = threading.Thread(target=self._worker_main, args=(opts,), daemon=True)
        self._worker.start()

    def _cancel(self) -> None:
        self._cancel_event.set()
        self._set_status("Cancelling…", "#86868B")

    def _worker_main(self, opts: MergeOptions) -> None:
        """Runs in a worker thread - talks to the GUI ONLY through the queue."""
        try:
            result = merge_folder(
                opts,
                progress=lambda d, t, m: self._events.put(("progress", d, t, m)),
                cancel=self._cancel_event,
            )
            self._events.put(("done", result))
        except PermissionError:
            self._events.put(("error", "Write access denied. Close the file in Excel or choose another folder."))
        except Exception as exc:  # noqa: BLE001
            log.error("Merge failed:\n%s", traceback.format_exc())
            where = error_location(exc)
            self._events.put(("error", f"{type(exc).__name__}: {exc}" + (f"  [{where}]" if where else "")))

    def _poll_events(self) -> None:
        try:
            while True:
                event = self._events.get_nowait()
                kind = event[0]
                if kind == "progress":
                    _, done, total, msg = event
                    self.progress.config(value=100 * done / max(total, 1))
                    self._set_status(msg, "#0071E3")
                elif kind == "done":
                    self._on_done(event[1])
                elif kind == "error":
                    self._set_running(False)
                    self.progress.config(value=0)
                    self._set_status(f"Error: {event[1]}", "#D70015")
        except queue.Empty:
            pass
        self.after(100, self._poll_events)

    def _on_done(self, res: MergeResult) -> None:
        self._set_running(False)
        if res.cancelled:
            self.progress.config(value=0)
            self._set_status("Cancelled - no file was saved.", "#86868B")
            return

        self.progress.config(value=100)
        has_issues = bool(res.errors or res.warnings)
        out_name = res.output_file.name if res.output_file else ""
        rep_name = res.report_file.name if res.report_file else "(report not saved)"
        msg = (f"Done: {res.files_ok}/{res.files_total} files, {res.sheets} sheets\n"
               f"Rows: {res.rows_read:,} read, {res.rows_removed:,} removed, {res.rows:,} in output\n"
               f"{out_name}  |  {rep_name}")
        self._set_status(msg, "#FF9500" if res.errors else "#28CD41")

        if has_issues:
            messagebox.showwarning("Merge report", self._format_report(res))
        if self.var_open.get() and res.output_file and hasattr(os, "startfile"):
            try:
                os.startfile(res.output_file.parent)  # type: ignore[attr-defined]
            except OSError:
                pass

    @staticmethod
    def _format_report(res: MergeResult, limit: int = 15) -> str:
        lines: List[str] = []
        if res.errors:
            lines.append(f"Files with errors ({len(res.errors)}):")
            lines += [f"  • {e}" for e in res.errors[:limit]]
            if len(res.errors) > limit:
                lines.append("  …")
        if res.warnings:
            lines.append(f"\nWarnings ({len(res.warnings)}):")
            lines += [f"  • {w}" for w in res.warnings[:limit]]
            if len(res.warnings) > limit:
                lines.append("  …")
        if res.report_file:
            lines.append(f"\nTXT report: {res.report_file}")
        lines.append(f"Full log: {LOG_FILE}")
        return "\n".join(lines)

    def _on_close(self) -> None:
        self._save_settings()
        self._cancel_event.set()
        self.destroy()


def main() -> None:
    try:
        enable_dpi_awareness()
        app = MergerApp()
        log.info("Main loop started.")
        app.mainloop()
    except Exception as exc:  # noqa: BLE001
        log.critical("FATAL CRASH:\n%s", traceback.format_exc())
        show_native_error("Critical application error", f"An error occurred:\n\n{exc}\n\nSee: {LOG_FILE}")
        sys.exit(1)


if __name__ == "__main__":
    main()
