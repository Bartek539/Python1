# 4. SILNIK A: "MERGE LIKE HUMAN" (Windows Excel COM Automation)
# =============================================================================
def merge_folder_like_human(
    opts: MergeOptions,
    files: List[Path],
    progress: Optional[ProgressCb] = None,
    cancel: Optional[threading.Event] = None,
) -> MergeResult:
    """
    Kopiuje dane arkusz po arkuszu, odzwierciedlając pracę człowieka (Ctrl+A -> Ctrl+C -> PasteAll).
    Zachowuje formuły, style, formatowanie liczb, kolory tła i szerokości kolumn.
    Wymaga środowiska Windows i zainstalowanego pakietu Microsoft Excel.
    """
    try:
        import pythoncom
        import win32com.client as win32
    except ImportError as e:
        raise RuntimeError("Brak biblioteki pywin32! Zainstaluj: pip install pywin32") from e

    # Inicjalizacja COM w wątku roboczym (zapobiega crashowi wątkowości w Windows)
    pythoncom.CoInitialize()

    report: ProgressCb = progress or (lambda d, t, m: None)
    res = MergeResult()
    res.files_total = len(files)
    total_steps = len(files) + 1

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    output_file = opts.output_dir / f"{OUTPUT_PREFIX}human_{stamp}.xlsx"

    excel = None
    target_wb = None

    try:
        try:
            excel = win32.gencache.EnsureDispatch("Excel.Application")
        except Exception:
            excel = win32.Dispatch("Excel.Application")

        # Optymalizacja wykonania i wyciszenie komunikatów Excela
        excel.Visible = False
        excel.DisplayAlerts = False
        excel.ScreenUpdating = False
        excel.CutCopyMode = False

        sheet_tracker: Dict[str, Tuple[any, int]] = {}  # sheet_key -> (ws_reference, last_row)

        target_wb = excel.Workbooks.Add()
        default_sheet = target_wb.Worksheets(1)
        default_sheet.Name = "__TEMP_INITIALIZER__"

        for n, file_path in enumerate(files):
            if cancel is not None and cancel.is_set():
                res.cancelled = True
                break

            report(n, total_steps, f"[Tryb Human] Scalanie pliku {n + 1}/{len(files)}: {file_path.name}")
            source_wb = None

            try:
                # Otwarcie pliku w trybie ReadOnly zapobiega blokadom i powiadomieniom
                source_wb = excel.Workbooks.Open(
                    str(file_path.resolve()), ReadOnly=True, UpdateLinks=0, IgnoreReadOnlyRecommended=True
                )

                for src_ws in source_wb.Worksheets:
                    used_range = src_ws.UsedRange
                    row_count = used_range.Rows.Count
                    col_count = used_range.Columns.Count

                    # Pomijamy arkusze całkowicie puste
                    if row_count == 1 and col_count == 1 and used_range.Cells(1, 1).Value is None:
                        continue

                    raw_name = src_ws.Name.strip()
                    sheet_key = raw_name.casefold()

                    if sheet_key not in sheet_tracker:
                        # Tworzymy nowy arkusz docelowy
                        safe_name = _BAD_SHEET_CHARS.sub("_", raw_name)[:31] or "Sheet"
                        target_ws = target_wb.Worksheets.Add(After=target_wb.Worksheets(target_wb.Worksheets.Count))
                        try:
                            target_ws.Name = safe_name
                        except Exception:
                            target_ws.Name = f"Sheet_{len(sheet_tracker) + 1}"

                        # Kopiuj wszystko: Ctrl+A -> Ctrl+C -> xlPasteAll
                        used_range.Copy()
                        dest_cell = target_ws.Cells(1, 1)
                        dest_cell.PasteSpecial(-4104)  # xlPasteAll
                        try:
                            dest_cell.PasteSpecial(8)      # xlPasteColumnWidths
                        except Exception:
                            pass

                        excel.CutCopyMode = False
                        sheet_tracker[sheet_key] = (target_ws, row_count)
                        res.stats.append(SheetStat(file=file_path.name, sheet=raw_name, raw=row_count, kept=row_count))
                    else:
                        target_ws, current_last_row = sheet_tracker[sheet_key]
                        start_paste_row = current_last_row + 1

                        # Doklejanie danych poniżej poprzednich wpisów
                        used_range.Copy()
                        dest_cell = target_ws.Cells(start_paste_row, 1)
                        dest_cell.PasteSpecial(-4104)  # xlPasteAll
                        excel.CutCopyMode = False

                        new_last_row = current_last_row + row_count
                        sheet_tracker[sheet_key] = (target_ws, new_last_row)
                        res.stats.append(SheetStat(file=file_path.name, sheet=raw_name, raw=row_count, kept=row_count))

                source_wb.Close(SaveChanges=False)
                res.files_ok += 1

            except Exception as src_exc:
                log.error("Błąd COM w pliku %s:\n%s", file_path.name, traceback.format_exc())
                res.errors.append(f"{file_path.name}: {type(src_exc).__name__}: {src_exc}")
                if source_wb:
                    try:
                        source_wb.Close(SaveChanges=False)
                    except Exception:
                        pass

        # Usunięcie tymczasowego początkowego arkusza
        try:
            default_sheet.Delete()
        except Exception:
            pass

        if not res.cancelled and sheet_tracker:
            report(len(files), total_steps, "Zapisywanie wynikowego pliku Excel...")
            # 51 = xlOpenXMLWorkbook (.xlsx)
            target_wb.SaveAs(str(output_file.resolve()), FileFormat=51)
            res.output_file = output_file
            res.sheets = len(sheet_tracker)
            res.rows = sum(st.kept for st in res.stats)
            res.out_sheets = [(ws.Name, last_r) for _, (ws, last_r) in sheet_tracker.items()]

    finally:
        # Pancerne sprzątanie zasobów COM zapobiegające powstawaniu procesów zombie
        if target_wb:
            try:
                target_wb.Close(SaveChanges=False)
            except Exception:
                pass
        if excel:
            try:
                excel.CutCopyMode = False
                excel.ScreenUpdating = True
                excel.DisplayAlerts = True
                excel.Quit()
            except Exception:
                pass
        del target_wb
        del excel
        pythoncom.CoUninitialize()

    return res


