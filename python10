def _read_text_any_encoding(path: Path) -> str:
    for enc in CSV_ENCODINGS:
        try:
            with open(path, "r", encoding=enc, newline="") as fh:
                return fh.read()
        except UnicodeDecodeError:
            continue
    raise ValueError(f"Nie udało się rozpoznać kodowania pliku {path.name}")

def _sniff_delimiter(text: str) -> str:
    sample = text[:50_000]
    try:
        return csv.Sniffer().sniff(sample, delimiters=",;\t|").delimiter
    except csv.Error:
        lines = sample.splitlines()
        first = lines[0] if lines else ""
        return max(",;\t|", key=first.count) if first else ","

def read_csv_raw(path: Path) -> pd.DataFrame:
    text = _read_text_any_encoding(path)
    if not text.strip():
        return pd.DataFrame()
    delim = _sniff_delimiter(text)
    reader = csv.reader(io.StringIO(text, newline=""), delimiter=delim)
    ncols = max((len(r) for r in reader), default=0)
    if ncols == 0:
        return pd.DataFrame()
    return pd.read_csv(
        io.StringIO(text, newline=""),
        sep=delim,
        header=None,
        names=list(range(ncols)),
        dtype=str,
        engine="python",
        skip_blank_lines=False,
    )

def read_workbook(path: Path) -> List[Tuple[Optional[str], pd.DataFrame]]:
    ext = path.suffix.lower()
    if ext == ".csv":
        return [(None, read_csv_raw(path))]
    result: List[Tuple[Optional[str], pd.DataFrame]] = []
    with pd.ExcelFile(path, engine=excel_engine(ext)) as xls:
        for name in xls.sheet_names:
            result.append((str(name), xls.parse(name, header=None)))
    return result

def dedupe_columns(cols: List[str]) -> List[str]:
    seen: Dict[str, int] = {}
    out: List[str] = []
    for c in cols:
        if c in seen:
            seen[c] += 1
            out.append(f"{c}.{seen[c]}")
        else:
            seen[c] = 0
            out.append(c)
    return out

def header_text(value, idx: int) -> str:
    try:
        if pd.isna(value):
            return f"Unnamed: {idx}"
    except (TypeError, ValueError):
        pass
    if isinstance(value, float) and value.is_integer():
        value = int(value)
    return re.sub(r"\s+", " ", str(value)).strip() or f"Unnamed: {idx}"

def numeric_where_possible(df: pd.DataFrame) -> pd.DataFrame:
    if df.shape[1] == 0:
        return df
    cols = {}
    for i, name in enumerate(df.columns):
        series = df.iloc[:, i]
        try:
            series = pd.to_numeric(series)
        except (ValueError, TypeError):
            pass
        cols[name] = series
    return pd.DataFrame(cols, index=df.index)

def process_raw(
    raw: pd.DataFrame, skip_top: int, skip_bottom: int, from_csv: bool
) -> Tuple[pd.DataFrame, SheetStat]:
    st = SheetStat(raw=len(raw), is_csv=from_csv)
    nothing = pd.DataFrame()

    st.top = min(skip_top, len(raw))
    rest = raw.iloc[st.top:]
    if rest.empty:
        return nothing, st

    blank = rest.isna().all(axis=1).to_numpy()
    filled_pos = (~blank).nonzero()[0]
    if len(filled_pos) == 0:
        st.empty = len(rest)
        return nothing, st

    h = int(filled_pos[0])
    st.empty = h
    st.header = 1
    header_vals = rest.iloc[h].tolist()

    body = rest.iloc[h + 1:]
    body_filled = body.dropna(how="all")
    st.empty += len(body) - len(body_filled)
    body = body_filled

    keep = [
        i for i, v in enumerate(header_vals)
        if not (pd.isna(v) and body.iloc[:, i].isna().all())
    ]
    names = dedupe_columns([header_text(header_vals[i], i) for i in keep])
    body = body.iloc[:, keep].copy()
    body.columns = names

    cut = min(skip_bottom, len(body)) if skip_bottom > 0 else 0
    if cut:
        body = body.iloc[:-cut]
        st.footer = cut

    body = numeric_where_possible(body) if from_csv else body.infer_objects()
    body = body.reset_index(drop=True)
    st.kept = len(body)
    return body, st

def sanitize_for_excel(df: pd.DataFrame) -> pd.DataFrame:
    obj_cols = [c for c in df.columns if df[c].dtype.kind == "O"]
    if not obj_cols:
        return df
    df = df.copy()
    for c in obj_cols:
        df[c] = df[c].map(lambda v: _ILLEGAL_XML.sub("", v) if isinstance(v, str) else v)
    return df

def format_sheet(ws, df: pd.DataFrame) -> None:
    from openpyxl.styles import Font
    from openpyxl.utils import get_column_letter

    if df.shape[1] == 0:
        return
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions
    bold = Font(bold=True)
    for idx, col in enumerate(df.columns, start=1):
        ws.cell(row=1, column=idx).font = bold
        longest = max([len(str(col))] + [len(str(v)) if not pd.isna(v) else 0 for v in df[col].head(500)])
        ws.column_dimensions[get_column_letter(idx)].width = min(max(10, longest + 2), 50)

def column_set(df: pd.DataFrame) -> Set[str]:
    return {str(c).casefold() for c in df.columns if c != SOURCE_COL}

def match_by_file_name(stem: str, known: Dict[str, str]) -> Optional[str]:
    text = stem.casefold()
    best: Optional[str] = None
    for key in known:
        if not key:
            continue
        pattern = r"(?<![^\W_])" + re.escape(key) + r"(?![^\W_])"
        if re.search(pattern, text) and (best is None or len(key) > len(best)):
            best = key
    return best

def match_by_headers(cols: Set[str], sheet_cols: Dict[str, Set[str]]) -> Optional[str]:
    best_key: Optional[str] = None
    best_score = 0.0
    for key, other in sheet_cols.items():
        union = len(cols | other)
        score = len(cols & other) / union if union else 0.0
        if score > best_score:
            best_key, best_score = key, score
    return best_key if best_score >= HEADER_MATCH_THRESHOLD else None

def group_sheet_name(stems: List[str]) -> str:
    base = os.path.commonprefix(stems) if len(stems) > 1 else stems[0]
    base = re.sub(r"[\W_]*\d[\d\W_]*$", "", base)
    base = re.sub(r"[\W_\d]+$", "", base)
    base = re.sub(r"^[\W_]+", "", base).strip()
    return base or DEFAULT_CSV_SHEET

def assign_csv_records(records: List[Record], res: MergeResult) -> None:
    known: Dict[str, str] = {}
    sheet_cols: Dict[str, Set[str]] = {}
    for r in records:
        if r.key is not None:
            known.setdefault(r.key, r.display)
            sheet_cols.setdefault(r.key, set()).update(column_set(r.df))

    pending: Dict[frozenset, List[Record]] = {}
    for r in records:
        if r.key is not None:
            continue
        key = match_by_file_name(Path(r.file).stem, known)
        method = "nazwa pliku"
        if key is None:
            key = match_by_headers(column_set(r.df), sheet_cols)
            method = "zgodność nagłówków"
        if key is not None:
            r.key, r.display, r.method = key, known[key], method
        else:
            pending.setdefault(frozenset(column_set(r.df)), []).append(r)

    for group in pending.values():
        name = group_sheet_name([Path(r.file).stem for r in group])
        key = name.casefold()
        known.setdefault(key, name)
        for r in group:
            r.key, r.display, r.method = key, known[key], "nowy arkusz"
        files = ", ".join(r.file for r in group[:3]) + (" …" if len(group) > 3 else "")
        res.warnings.append(
            f"Pliki CSV bez bezpośredniego dopasowania arkusza ({files}) przypisano do nowego arkusza '{known[key]}'."
        )

    for r in records:
        if r.stat.is_csv:
            r.stat.sheet = f"{r.display} (CSV)"
    res.csv_assignments = [
        (r.file, r.display, r.method) for r in records if r.stat.is_csv and r.method
    ]


