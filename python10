def build_report(res: MergeResult, opts: MergeOptions, generated: datetime) -> str:
    bar = "=" * 80
    thin = "-" * 80
    out_name = res.output_file.name if res.output_file else "-"
    n = lambda v: f"{v:,}"

    L: List[str] = [
        bar,
        f"{APP_NAME} v{APP_VERSION} - RAPORT PODSUMOWANIA SCALANIA",
        bar,
        f"Data wygenerowania: {generated:%Y-%m-%d %H:%M:%S}",
        f"Zastosowany tryb  : {'Merge Like Human (COM Automation)' if opts.merge_like_human else 'Standard (Pandas / OpenPyXL)'}",
        f"Katalog wejściowy : {opts.input_dir}",
        f"Katalog docelowy  : {opts.output_dir}",
        f"Plik wynikowy     : {out_name}",
        f"Status plików     : {res.files_ok} / {res.files_total} przetworzonych pomyślnie",
        f"Arkusze w pliku   : {res.sheets}",
        "",
        thin,
        "ZESTAWIENIE WIERSZY",
        thin,
        f"Wiersze odczytane łącznie  : {n(res.rows_read):>16}",
        f"Wiersze pominięte/usunięte : {n(res.rows_removed):>16}",
        f"Wiersze w pliku wyjściowym : {n(res.rows):>16}",
        "",
    ]
    if res.out_sheets:
        L += [thin, "ROZKŁAD ARKUSZY WYNIKOWYCH", thin]
        w = max(len(name) for name, _ in res.out_sheets)
        for name, count in res.out_sheets:
            L.append(f"  {name.ljust(w)}  {n(count):>12} wierszy")

    if res.errors:
        L += ["", thin, f"BŁĘDY ({len(res.errors)})", thin]
        L += [f"  * {e}" for e in res.errors]
    if res.warnings:
        L += ["", thin, f"OSTRZEŻENIA ({len(res.warnings)})", thin]
        L += [f"  * {w}" for w in res.warnings]

    L.append("")
    return "\n".join(L)


# =============================================================================
# 7. DYSPOZYTOR GŁÓWNY (MERGE PIPELINE)
# =============================================================================
def merge_folder(
    opts: MergeOptions,
    progress: Optional[ProgressCb] = None,
    cancel: Optional[threading.Event] = None,
) -> MergeResult:
    report: ProgressCb = progress or (lambda done, total, msg: None)

    if not opts.input_dir.is_dir():
        raise ValueError("Wskazany folder wejściowy nie istnieje.")
    if not opts.output_dir.is_dir():
        raise ValueError("Wskazany folder wyjściowy nie istnieje.")

    files = [
        p for p in opts.input_dir.iterdir()
        if p.is_file() and p.suffix.lower() in SUPPORTED_EXTS and not p.name.startswith(("~$", OUTPUT_PREFIX))
    ]
    if not files:
        raise ValueError("Nie znaleziono obsługiwanych plików Excel ani CSV w katalogu.")

    codes: List[str] = []
    if opts.order_file:
        try:
            codes = read_order_list(opts.order_file)
        except Exception as exc:
            log.warning("Nie można odczytać pliku kolejności: %s", exc)

    if codes:
        files, _, _ = sort_files(files, codes)
    else:
        files.sort(key=lambda p: natural_key(p.name))

    # --- PRZEKIEROWANIE DO WYBRANEGO SILNIKA ---
    if opts.merge_like_human:
        res = merge_folder_like_human(opts, files, progress, cancel)
    else:
        res = MergeResult()
        res.files_total = len(files)
        total_steps = len(files) + 1
        records: List[Record] = []

        for n, path in enumerate(files):
            if cancel is not None and cancel.is_set():
                res.cancelled = True
                return res
            report(n, total_steps, f"Wczytywanie {n + 1}/{len(files)}: {path.name}")
            try:
                local_records: List[Record] = []
                local_stats: List[SheetStat] = []
                for sheet_name, raw in read_workbook(path):
                    is_csv = sheet_name is None
                    df, st = process_raw(raw, opts.skip_top, opts.skip_bottom, from_csv=is_csv)
                    st.file = path.name
                    st.sheet = "" if is_csv else sheet_name.strip()
                    local_stats.append(st)
                    if df.empty:
                        continue
                    if opts.add_source_column and SOURCE_COL not in df.columns:
                        df.insert(0, SOURCE_COL, path.name)
                    if is_csv:
                        local_records.append(Record(None, "", df, path.name, st))
                    else:
                        name = sheet_name.strip()
                        local_records.append(Record(name.casefold(), name, df, path.name, st))

                res.stats.extend(local_stats)
                records.extend(local_records)
                res.files_ok += 1
            except Exception as exc:
                log.error("Błąd w pliku %s:\n%s", path.name, traceback.format_exc())
                res.errors.append(f"{path.name}: {type(exc).__name__}: {exc}")

        if not records:
            raise ValueError("Brak danych tabelarycznych do połączenia po odfiltrowaniu.")

        assign_csv_records(records, res)

        sheets: Dict[str, Tuple[str, List[pd.DataFrame]]] = {}
        for r in records:
            sheets.setdefault(r.key, (r.display, []))[1].append(r.df)

        parts: List[Tuple[str, pd.DataFrame]] = []
        for display, frames in sheets.values():
            merged = pd.concat(frames, ignore_index=True, sort=False)
            if len(merged) > EXCEL_MAX_DATA_ROWS:
                for k, start in enumerate(range(0, len(merged), EXCEL_MAX_DATA_ROWS), start=1):
                    parts.append((f"{display} ({k})", merged.iloc[start : start + EXCEL_MAX_DATA_ROWS]))
            else:
                parts.append((display, merged))

        safe_names = make_safe_sheet_names([name for name, _ in parts])
        now = datetime.now()
        stamp = now.strftime("%Y%m%d_%H%M%S")
        output_file = opts.output_dir / f"{OUTPUT_PREFIX}{stamp}.xlsx"
        tmp_file = output_file.with_name(output_file.stem + ".tmp.xlsx")

        report(len(files), total_steps, "Zapisywanie pliku docelowego...")
        try:
            with pd.ExcelWriter(tmp_file, engine="openpyxl") as writer:
                for (_, df), name in zip(parts, safe_names):
                    df = sanitize_for_excel(df)
                    df.to_excel(writer, sheet_name=name, index=False)
                    try:
                        format_sheet(writer.sheets[name], df)
                    except Exception:
                        pass
            os.replace(tmp_file, output_file)
        except Exception:
            tmp_file.unlink(missing_ok=True)
            raise

        res.output_file = output_file
        res.sheets = len(parts)
        res.rows = sum(len(df) for _, df in parts)
        res.out_sheets = [(name, len(df)) for (_, df), name in zip(parts, safe_names)]

    # --- ZAPIS RAPORTU PLIKOWEGO ---
    now = datetime.now()
    stamp = now.strftime("%Y%m%d_%H%M%S")
    report_file = opts.output_dir / f"{REPORT_PREFIX}{stamp}.txt"
    try:
        report_file.write_text(build_report(res, opts, now), encoding="utf-8-sig")
        res.report_file = report_file
    except OSError as exc:
        res.warnings.append(f"Nie udało się zapisać pliku raportu TXT: {exc}")

    report(len(files) + 1, len(files) + 1, "Zakończono")
    return res


